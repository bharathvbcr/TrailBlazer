<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+ backup and device transfer. Location history (Room database) is never uploaded to
     cloud backup (only preferences are included there); it may move to a new device over a direct
     device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/" />
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
